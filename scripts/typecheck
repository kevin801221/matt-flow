#!/bin/sh
# Type-checks the mod against the Claude Code types the plugin-authoring skill last unpacked.
# ponytail: those types live only in a session's temp folder, and the newest may be another
# Claude Code version's; a copy the engine kept in place would end the hunt.
cd "$(dirname "$0")/.." || exit 1
dts=$(ls -t /tmp/claude-*/bundled-skills/*/*/plugin-authoring/types/claude-code.d.ts 2>/dev/null | head -1)
if [ -z "$dts" ]; then
  echo "typecheck skipped: no Claude Code types yet; load the plugin-authoring skill in a session, then run it again"
  exit 0
fi
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
cat > "$dir/tsconfig.json" <<EOF
{
  "compilerOptions": {
    "target": "es2023", "lib": ["es2023"], "types": [],
    "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "skipLibCheck": true,
    "jsx": "react", "jsxFactory": "h", "jsxFragmentFactory": "Fragment"
  },
  "include": ["$dts", "$PWD/hooks", "$PWD/types"]
}
EOF
npx -y -p typescript@5.6.3 tsc -p "$dir/tsconfig.json"
